# Supabase/Postgres connection used by TanStack Start server functions.
# Set these in Vercel for Production, Preview, and Development.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-exposed Supabase values for client-side auth and inserts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: only needed if scheduled/cron routes are added.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
