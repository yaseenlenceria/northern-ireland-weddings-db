# Postgres connection used by public directory server functions.
# Vercel/Neon commonly provides POSTGRES_URL. DATABASE_URL also works.
POSTGRES_URL=
DATABASE_URL=

# Legacy Supabase values are only needed while auth/planning-tool pages still use Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed if scheduled/cron routes are added.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
