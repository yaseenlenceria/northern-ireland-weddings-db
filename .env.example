POSTGRES_URL=
DATABASE_URL=
# Set this only after the custom domain is purchased, connected and resolving.
# VITE_SITE_URL=https://niamhweddings.ie
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=

# Optional: only needed if scheduled/cron routes are added.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
