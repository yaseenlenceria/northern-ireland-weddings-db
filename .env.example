# Postgres connection used by public directory server functions.
# Vercel/Neon commonly provides POSTGRES_URL. DATABASE_URL also works.
POSTGRES_URL=
DATABASE_URL=
# Public domain used for canonical URLs, sitemap entries and social sharing.
# VITE_SITE_URL=https://wedhq.co.uk
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=

# Optional email delivery for contact, enquiry and business listing notifications.
# Add these in Vercel Production/Preview after verifying the sender domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=WedHQ <hello@wedhq.co.uk>
WEDHQ_ADMIN_EMAIL=

# Optional: only needed if scheduled/cron routes are added.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
